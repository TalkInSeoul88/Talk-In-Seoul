{
  "rewrites": [
    { "source": "/((?!api/|materials/|audio/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/admin/*.js": {
      "includeFiles": "api/_lib/**"
    },
    "api/access/*.js": {
      "includeFiles": "api/_lib/**"
    },
    "api/class/*.js": {
      "includeFiles": "api/_lib/**"
    },
    "api/class/material.js": {
      "includeFiles": "{api/_lib,content/materials}/**"
    }
  }
}
