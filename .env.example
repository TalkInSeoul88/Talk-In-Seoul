# Server-only. Never prefix these with VITE_ — that would leak them to the browser.

# Required for /admin unlock. Set this in Vercel → Project → Settings → Environment Variables
# for Production and Preview. Pick a long password only Jung knows.
ADMIN_PASSWORD=

# Optional. If unset, the admin session key is derived from ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=

# Production store for issued codes (survives deploys). Do not use localStorage for this.
# 1. Vercel dashboard → Storage → Create Database → Blob
# 2. Access: Private (recommended). If your store is public-only, also set BLOB_ACCESS=public
# 3. Connect the store to this Talk in Seoul project (Production + Preview)
# Vercel then injects BLOB_STORE_ID (OIDC) and/or BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Optional. Default is private Blob access.
# BLOB_ACCESS=private

# Local `npm run dev` without Blob writes to .data/access-codes.json (gitignored).
